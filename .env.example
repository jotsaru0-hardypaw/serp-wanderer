# Postgres connection string (Neon, Render Postgres, Supabase, etc all work) — required.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Any random long string — protects the /api/cron/refresh endpoint from public calls. Required.
CRON_SECRET="pick-a-long-random-string"

# Optional. Your Bright Data API key and SERP zone name can instead be entered
# on the app's Settings page (stored in the database) — set these here only
# if you'd rather configure them via env vars/CI instead of the UI. Whatever
# is saved in Settings takes priority over these.
# BRIGHTDATA_API_KEY="your-bright-data-api-key"
# BRIGHTDATA_SERP_ZONE="your-serp-zone-name"
